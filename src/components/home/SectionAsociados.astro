---
import '@/styles/components/home/sectionAlliances.css';
import '@/styles/components/home/sectionAsociados.css';
import "swiper/swiper-bundle.css";
import CardAlliances from "../cards/CardAlliances.astro";
import { getAssociates, createAssociateFromPost } from "./SectionAsociados.component";

const postsAssociate = await getAssociates();
---

<div class="section__container">
    <h2 class="section__title__asociados ">Clientes Globales</h2>
    <div id="swiper-associate" class="swiper-container">
        <div class="swiper-wrapper">
            {postsAssociate.map((post) => (
                    <div class="swiper-slide">
                        <CardAlliances client={createAssociateFromPost(post)} />
                    </div>
            ))}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        import('../../scripts/swiper-carousel-alliances_index').then((module) => {
            module.initializeSwiperAssociate('#swiper-associate');
        });
    });
</script>

