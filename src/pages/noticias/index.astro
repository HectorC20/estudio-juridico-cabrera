---
import Layout from "@/layouts/Layout.astro";
import FormattedDate from "@/components/common/FormattedDate.astro";
import SearchNotice from "@/components/news/SearchNotice.astro";
import { NewsService } from "@/services/NewsService";
import type { NewsSummary } from "@/models/NewsSummary";
import "@/styles/noticiasIndex.css";

let newsList: NewsSummary[] = [];

try {
    newsList = await NewsService.getNewsList();
} catch (error) {
    console.error("Error al obtener las noticias:", error);
    newsList = [];
}

// Función para barajar aleatoriamente las noticias
const shuffleArray = <T,>(array: T[]): T[] => {
    const arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
};

// Barajamos las noticias
const shuffledNews = shuffleArray(newsList);

// Si deseas aplicar el filtro de búsqueda, usa shuffledNews en lugar de sortedNews
let filteredNews: NewsSummary[] = shuffledNews;

// const handleSearchResults = (event: Event) => {
//     const detail = (event as CustomEvent).detail as NewsSummary[];
//     filteredNews = detail.length > 0 ? detail : shuffledNews;
// };
---

<Layout title="Noticias - Estudio Jurídico Cabrera" description="Manténgase al día con las últimas noticias legales, actualizaciones del sector y novedades de Estudio Jurídico Cabrera para estar siempre informado sobre sus derechos">

    <main id="notice">
        <section>

            <div class="hero-image">
                <div class="hero-cont">
                    <h1>NOTICIAS</h1>
                    <h2>Infórmate sobre las últimas novedades legales y actualizaciones del Estudio Jurídico Cabrera.
                        Accede a análisis de cambios normativos, resoluciones clave y consejos prácticos de nuestros
                        expertos.</h2>
                </div>
                <img src="https://res.cloudinary.com/dixzojb4s/image/upload/v1729025386/noticias_sa4pep.jpg"
                     alt="Noticias de ESTUDIO " class=""/>

                <SearchNotice/>
            </div>

            <div class="flex flex-col">
                <ul id="newsList">
                    {
                        shuffledNews.map((post: NewsSummary) => (
                                <li class="rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105 min-h-[22em]">
                                    <a href={`/noticias/${post.newsName}/`} class="block">
                                        <img src={post.heroImage || 'https://via.placeholder.com/400x200'} alt={post.newsName} class="w-full min-h-[12em] object-cover"/>
                                        <div class="text-overlay">
                                            <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">{post.title}</h4>
                                            <p class="date 2xl:text-xl text-secondaryLocal">
                                                <FormattedDate date={new Date(post.pubDate || new Date())}/>
                                            </p>
                                            <div class="more__des">Leer Más</div>
                                            <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
                                        </div>
                                    </a>
                                </li>
                        ))
                    }
                </ul>
            </div>
        </section>
    </main>

    <script define:vars={{ initialNews: shuffledNews }}>
        import { NewsFilterService } from "@/services/NewsFilterService";

        const newsListContainer = document.getElementById('newsList');

        document.addEventListener('newsSearchQuery', (event) => {
            const query = event.detail;
            const filtered = NewsFilterService.filterByTitle(initialNews, query);
            renderNews(filtered);
        });

        function renderNews(news) {
            if (!newsListContainer) return;
            
            if (news.length === 0) {
                newsListContainer.innerHTML = '<li class="text-center w-full p-4 text-gray-500">No se encontraron noticias.</li>';
                return;
            }

            const html = news.map(post => {
                // Reconstruir la URL de la imagen y fecha formateada manualmente o usando librerías si están disponibles en el cliente
                // Para simplificar y evitar problemas de importación de FormattedDate (componente Astro), usamos JS estándar.
                
                const dateObj = new Date(post.pubDate || new Date());
                const formattedDate = dateObj.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

                return `
                <li class="rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105 min-h-[22em]">
                    <a href="/noticias/${post.newsName}/" class="block">
                        <img src="${post.heroImage || 'https://via.placeholder.com/400x200'}" alt="${post.newsName}" class="w-full min-h-[12em] object-cover"/>
                        <div class="text-overlay">
                            <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">${post.title}</h4>
                            <p class="date 2xl:text-xl text-secondaryLocal">
                                ${formattedDate}
                            </p>
                            <div class="more__des">Leer Más</div>
                            <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
                        </div>
                    </a>
                </li>
                `;
            }).join('');

            newsListContainer.innerHTML = html;
        }
    </script>
</Layout>
