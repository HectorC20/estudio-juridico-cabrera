---
import Layout from "../layouts/Layout.astro";
import '../styles/contactenos.css';
import SectionPages from "../components/SectionPages.astro";
---

<Layout
        title="Página no encontrada | Estudio Jurídico Cabrera"
        description="Lo sentimos, la página que buscas no se encuentra disponible.">

    <SectionPages
            title="Página no encontrada"
            description="Parece que la página que buscas no está disponible o ha sido movida.">

        <div class="h-screen  bg-gray-50 flex items-center">
            <div class="container flex flex-col md:flex-row items-center justify-between px-5 text-gray-700">

                <!-- Mensaje de error -->
                <div class="w-full lg:w-1/2 mx-8 ">
                    <div class="text-4xl font-extrabold flex justify-center mb-8">404</div>
                    <p class="text-2xl md:text-3xl font-light leading-normal mb-8">
                        Lo sentimos, no encontramos la página que buscas.
                    </p>
                    <div class="flex justify-center ">
                        <a href="/"
                           class="px-5 py-3 text-sm font-medium shadow-lg text-primaryLocal transition-all duration-400 border border-transparent rounded-lg focus:outline-none bg-secondaryLocal hover:bg-red-700">
                            Volver al inicio
                        </a>
                    </div>
                </div>

                <!-- Imagen decorativa -->
                <div class="w-full lg:flex lg:justify-end lg:w-1/2 mx-5 my-12">
                    <img src="https://user-images.githubusercontent.com/43953425/166269493-acd08ccb-4df3-4474-95c7-ad1034d3c070.svg"
                         alt="Página no encontrada">
                </div>

            </div>
        </div>

    </SectionPages>
</Layout>
