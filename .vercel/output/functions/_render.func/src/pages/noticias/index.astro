---
import Layout from "../../layouts/Layout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import SearchNotice from "../../components/SearchNotice.astro";
import { API_BASE_URL } from "../../consts";
import "../../styles/noticiasIndex.css";
const apiUrl = `${API_BASE_URL}/news/newsList`;

interface NewsItem {
    newsName: string;
    title: string;
    pubDate: string;
    heroImage?: string;
}

let newsList: NewsItem[] = [];

try {
    const response = await fetch(apiUrl);
    if (!response.ok) throw new Error(`HTTP Error! Status: ${response.status}`);
    newsList = (await response.json()) as NewsItem[];
} catch (error) {
    console.error("Error al obtener las noticias:", error);
    newsList = [];
}

const sortedNews = newsList.sort((a, b) =>
    new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
);
let filteredNews: NewsItem[] = sortedNews;

const handleSearchResults = (event: Event) => {
    const detail = (event as CustomEvent).detail as NewsItem[];
    filteredNews = detail.length > 0 ? detail : sortedNews;
};
---

<script type="module">
    document.addEventListener('newsSearchResults', (event) => {
        const detail = event.detail;
        const newsList = document.getElementById('newsList');

        if (detail.length > 0) {
            newsList.innerHTML = ''; // Limpiar solo el contenido sin reemplazar la estructura ni los estilos

            detail.forEach((post) => {
                const listItem = document.createElement('li');
                listItem.className = "rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105 min-h-[22em]";

                listItem.innerHTML = `
                    <a href="/noticias/${post.newsName}/" class="block">
                        <img src="${post.heroImage || 'https://via.placeholder.com/400x200'}" alt="" class="w-full min-h-[12em] object-cover"/>
                        <div class="text-overlay">
                            <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">${post.title}</h4>
                            <p class="date 2xl:text-xl text-secondaryLocal">${new Date(post.pubDate).toLocaleDateString()}</p>
                            <div class="more__des">Leer Más</div>
                            <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
                        </div>
                    </a>
                `;

                newsList.appendChild(listItem);
            });
        }
    });
</script>


<Layout title="NOTICIAS | ESTUDIO JURIDICO CABRERA" description="Las noticias de ESTUDIO JURÍDICO CABRERA">

    <main id="notice">

        <section>

            <div class="hero-image">
                <div class="hero-cont">
                    <h1>NOTICIAS</h1>
                    <h2>Infórmate sobre las últimas novedades legales y actualizaciones del Estudio Jurídico Cabrera.
                        Accede a análisis de cambios normativos, resoluciones clave y consejos prácticos de nuestros
                        expertos.</h2>
                </div>
                <img src="https://res.cloudinary.com/dixzojb4s/image/upload/v1729025386/noticias_sa4pep.jpg"
                     alt="Noticias de ESTUDIO " class=""/>

                <SearchNotice/>
            </div>
            <div class="flex flex-col ">
                <ul id="newsList">
                    {
                        sortedNews.map((post: NewsItem) => (
                                <li class="rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105 min-h-[22em]">
                                    <a href={`/noticias/${post.newsName}/`} class="block">
                                        <img src={post.heroImage || 'https://via.placeholder.com/400x200'} alt="" class="w-full min-h-[12em] object-cover"/>
                                        <div class="text-overlay">
                                            <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">{post.title}</h4>
                                            <p class="date 2xl:text-xl text-secondaryLocal">
                                                <FormattedDate date={new Date(post.pubDate)}/>
                                            </p>
                                            <div class="more__des">Leer Más</div>
                                            <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
                                        </div>
                                    </a>
                                </li>
                        ))
                    }
                </ul>
            </div>
        </section>
    </main>
</Layout>
