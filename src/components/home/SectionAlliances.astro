    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            import('../../scripts/swiper-carousel-alliances').then((module) => {
                module.initializeSwiperClient('#swiper-client');
                module.initializeSwiperAssociate('#swiper-associate');
            });
        });
    </script>
</SectionPages>

