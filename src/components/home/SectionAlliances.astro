---
import CardClient from "../cards/CardClient.astro";
import '@/styles/components/home/sectionAlliances.css';
import "swiper/swiper-bundle.css";
import SectionPages from "../common/SectionPages.astro";
import { getClients, createClientFromPost } from "./SectionAlliances.component";

const postsClient = await getClients();

---

<SectionPages title="CLIENTES" description="Clientes destacados y asociados globales que fortalecen nuestro compromiso con la excelencia legal.">
    <div class="section__container">
        <h2 class="section__heading">CLIENTES</h2>
        <!-- Swiper para clientes -->
        <div id="swiper-client" class="swiper-container" >
            <div class="swiper-wrapper">
                {postsClient.map((post) => (
                        <div class="swiper-slide">
                            <CardClient
                                client={createClientFromPost(post)}
                            />

                        </div>
                ))}
            </div>
            <div id="swiper-button-next-client" class="swiper-button-next"></div>
            <div id="swiper-button-prev-client" class="swiper-button-prev"></div>
            <div id="swiper-pagination-client" class="swiper-pagination"></div>
        </div>


        <!-- Swiper para asociados -->
