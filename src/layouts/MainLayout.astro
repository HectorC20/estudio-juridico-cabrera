---
import Footer from "../components/partials/Footer.astro";
import NavBar from "../components/partials/Navbar.astro";
import ScriptAnimation from "../components/widgets/ScriptAnimation.vue";
import MainHeader from "../components/partials/MainHeader.astro";
import ScriptWhatsApp from "../components/widgets/ScriptWhatsApp.vue";
// import ScriptTawkto from "../components/ScriptTawkto.vue";
import { SeoMetadataService } from "../services/SeoMetadataService";
import { SeoSchemaService } from "../services/SeoSchemaService";
import SchemaOrg from "../components/common/SchemaOrg.astro";

interface Props {
    title: string;
    description: string;
    image?: string;
}

const {title: defaultTitle, description: defaultDescription, image = '/blog-placeholder-1.webp'} = Astro.props;
const currentPath = Astro.url.pathname;

// Fetch dynamic metadata and schema
const metadata = await SeoMetadataService.getMetadata(currentPath);
const schemaData = await SeoSchemaService.getSchema('LegalService'); // Default to LegalService for main pages

// Resolve final values
const title = metadata?.title || defaultTitle;
const description = metadata?.description || defaultDescription;
const robots = metadata?.robots || "index, follow";
const canonicalURL = metadata?.canonicalUrl || new URL(currentPath, Astro.site).href;
const finalImage = metadata?.ogImage || image;

---
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="keywords" content="Piura, Tumbes, Lima, Trujillo, Perú, Sullana, Aguas Verdes, Puyango, Estudio Jurídico Cabrera, abogados en Piura, abogados en Tumbes, derecho civil, derecho penal, derecho laboral, asesoría legal, estudio de abogados, defensa legal, contratos, derecho de familia, herencias, sucesiones, trámites legales, asesoría empresarial, litigios, demandas, derecho comercial, derecho administrativo, derecho tributario, consultoría legal, arbitraje, conciliaciones, legalización de documentos, notaría, abogado especializado, bufete de abogados, representación legal, leyes en Perú, normativas legales, asistencia jurídica, jurisprudencia, Código Civil, Código Penal, asesoría en contratos, redacción de documentos legales, defensa judicial">

    <!-- Font preloads -->
    <link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin/>
    <link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin/>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL}/>
    <!--Robots-->
    <meta name="robots" content={robots}>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title}/>
    <meta name="description" content={description}/>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={Astro.url}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={new URL(finalImage, Astro.url)}/>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content={Astro.url}/>
    <meta property="twitter:title" content={title}/>
    <meta property="twitter:description" content={description}/>
    <meta property="twitter:image" content={new URL(finalImage, Astro.url)}/>
    <!--    Font externo-->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
          rel="stylesheet">
    <meta name="theme-color" content="#ffffff">

    <!-- Structured Data -->
    <SchemaOrg type="LegalService" data={schemaData} />
</head>

<body class="">
<MainHeader/>
<NavBar/>
<div class=" min-h-screen ">
    <slot/>
</div>
<Footer/>
<ScriptAnimation client:only="vue"/>
<ScriptWhatsApp client:only="vue"/>
<!-- <ScriptTawkto client:only="vue"/> -->

</body>
</html>
