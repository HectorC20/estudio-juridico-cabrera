---
import { getRelatedNews } from "./NewsTape.component";
import type { NewsSummary } from "@/models/NewsSummary";

const { slugActual } = Astro.props;
const uniquePosts = await getRelatedNews(slugActual);

---

<style>
    @keyframes shimmer {
        0% {
            background-position: -100%;
        }
        100% {
            background-position: 100%;
        }
    }

    .section__NewsTape {
        @apply flex flex-col my-0 md:mx-0 lg:mx-0 rounded-2xl py-0 lg:px-4 w-full lg:max-w-[22rem] xl:max-w-[24rem];
    }

    h4 {
        @apply mb-2 text-secondaryLocal text-xl lg:text-xl font-bold text-center uppercase tracking-wide;
        background: linear-gradient(90deg, #25439f, #619cdc, #25439f);
        background-size: 200%;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        animation: shimmer 3s infinite linear;
    }

    h5 {
        font-family: "Assistant", sans-serif;
        @apply break-words w-auto lg:flex-1 px-0 text-left text-sm font-semibold text-secondaryLocal leading-snug !important;
    }

    .list__News {
        li {
            @apply transition-transform duration-300 hover:-translate-y-1;
        }

        li:hover {
            img {
                @apply shadow-lg shadow-tertiaryLocal/20 ring-2 ring-tertiaryLocal/20;
            }

            h5 {
                @apply text-tertiaryLocal;
            }
        }

        a {
            @apply flex flex-col lg:flex-row items-center lg:items-start gap-3 py-3 border-b border-gray-100;
        }

        @apply flex flex-col sm:grid sm:grid-cols-2 sm:gap-6 lg:flex lg:flex-col lg:gap-0;
    }
</style>

<div class="section__NewsTape">
    <h4>Descubre más</h4>
    <ul class="list__News">
        {uniquePosts.map((post: NewsSummary) => (
                <li>
                    <a href={`/noticias/${post.newsName}/`}>
                        <img
                                src={post.heroImage || "/ruta/a/imagen/por/defecto.jpg"}
                                alt={post.title}
                                class="w-full h-40 sm:h-36 lg:w-24 lg:h-24 rounded-xl object-cover flex-shrink-0 transition-all duration-300"
                        />
                        <h5>
                            {post.title.length > 60 ? post.title.slice(0, 60) + "..." : post.title}
                        </h5>
                    </a>
                </li>
        ))}
    </ul>
</div>
