---
import Footer from "../components/partials/Footer.astro";
import NavBar from "../components/partials/Navbar.astro";
import Header from "../components/partials/Header.astro";
import ScriptAnimation from "../components/widgets/ScriptAnimation.vue";
import ScriptWhatsApp from "../components/widgets/ScriptWhatsApp.vue";
// import ScriptTawkto from "../components/ScriptTawkto.vue";
import { SeoMetadataService } from "../services/SeoMetadataService";
import { SeoSchemaService } from "../services/SeoSchemaService";
import SchemaOrg from "../components/common/SchemaOrg.astro";

interface Props {
    title: string;
    description: string;
    image?: string;
    authorName?: string;
    pubDate?: string | Date;
    robotsTag?: string;
    tags?: string[];
    categories?: string[];
    updatedDate?: Date;
}

const { 
    title: defaultTitle, 
    description: defaultDescription, 
    image = '/blog-placeholder-1.webp', 
    authorName = 'Autor desconocido', 
    pubDate = 'Fecha no disponible',
    robotsTag: defaultRobots = 'index, follow', 
    tags = [], 
    categories = [],
    updatedDate
} = Astro.props;

const currentPath = Astro.url.pathname;

// Fetch dynamic metadata
const metadata = await SeoMetadataService.getMetadata(currentPath);
// For articles, we might fetch specific schema enhancements or just use local data
const schemaOverride = await SeoSchemaService.getSchema('Article', currentPath.split('/').pop());

// Resolve final values
const title = metadata?.title || defaultTitle;
const description = metadata?.description || defaultDescription;
const robots = metadata?.robots || defaultRobots;
const canonicalURL = metadata?.canonicalUrl || new URL(currentPath, Astro.site).href;
const finalImage = metadata?.ogImage || image;

const keywords = [...tags, ...categories].join(", ");
const pubDateString = pubDate instanceof Date ? pubDate.toISOString() : pubDate || 'Fecha no disponible';

// Prepare data for SchemaOrg component
const articleData = {
    title,
    description,
    image: finalImage,
    authorName,
    pubDate,
    updatedDate,
    ...schemaOverride // Allow backend to override specific fields if needed
};
---

<!doctype html>
<head>
    <!-- Incluir JSON-LD via Componente Centralizado -->
    <SchemaOrg type="Article" data={articleData} />
    
    <meta name="keywords" content={keywords}/>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>

    <!-- URL canónica -->
    <link rel="canonical" href={canonicalURL}/>

    <!-- Metaetiquetas principales -->
    <title>{title}</title>
    <meta name="title" content={title}/>
    <meta name="description" content={description}/>

    <!-- Control de robots -->
    <meta name="robots" content={robots} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article"/>
    <meta property="og:url" content={canonicalURL}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={finalImage}/>

    <meta property="article:author" content={authorName}/>
    <meta property="article:published_time" content={pubDateString}/>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content={canonicalURL}/>
    <meta property="twitter:title" content={title}/>
    <meta property="twitter:description" content={description}/>
    <meta property="twitter:image" content={finalImage}/>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&display=swap" rel="stylesheet">
    <meta name="theme-color" content="#ffffff">
</head>

<body>
<Header/>
<NavBar/>
<div class="min-h-screen">
    <slot/>
</div>
<Footer/>
<ScriptAnimation client:only="vue"/>
<ScriptWhatsApp client:only="vue"/>
<!-- <ScriptTawkto client:only="vue"/> -->

</body>
