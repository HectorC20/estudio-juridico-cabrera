---
import CarouselBlog from "@/components/news/CarouselBlog.vue";
import MainLayout from "@/layouts/MainLayout.astro";
import SectionNosotros from "@/components/home/SectionNosotros.astro";
import SectionAsociados from "@/components/home/SectionAsociados.astro";
import SectionLoMejor from "@/components/home/SectionLoMejor.astro";
import LoadingScreen from "@/components/loader/Loading.astro";
import SectionNoticesHome from "@/components/home/SectionNoticesHome.astro";
import SectionLogros from "@/components/home/SectionLogros.astro";
import SectionWhyChooseUs from "@/components/home/SectionWhyChooseUs.astro";
import SectionSuccessCases from "@/components/home/SectionSuccessCases.astro";
---

<!doctype html>
<MainLayout title="Abogados en Tumbes - Estudio Jurídico Cabrera" description="¿Necesitas ayuda legal de confianza? En Estudio Jurídico Cabrera brindamos asesoría legal personalizada con un enfoque ético y profesional">
    <!-- Pantalla de carga -->
    <LoadingScreen />
    <div id="main-content" class="hidden">
        <CarouselBlog client:only="vue" />
        <SectionLogros/>
        <SectionNosotros />
        <SectionWhyChooseUs />
        <SectionAsociados />
        <SectionLoMejor />
        <SectionSuccessCases />
        <SectionNoticesHome/>
    </div>

    <style>
        .hidden {
            display: none;
        }
    </style>
</MainLayout>
