---
import type { Client } from "@/models/Client";

export interface Props {
    client: Client;
}
const { client } = Astro.props;
---
<style>
    .section__card__alianzas {
        @apply  w-[100%] h-[10em] bg-white rounded-lg overflow-hidden;
    }
    .section__card__img__alianzas {
        @apply w-full h-[10em] object-cover;
        filter: grayscale(100%);
    }
</style>
<div class="section__card__alianzas">
    <img class="section__card__img__alianzas" src={client.src} alt={client.alt} />
</div>
