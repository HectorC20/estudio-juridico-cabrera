---
import Footer from "../components/partials/Footer.astro";
import NavBar from "../components/partials/Navbar.astro";
import Header from "../components/partials/Header.astro";
import ScriptAnimation from "../components/widgets/ScriptAnimation.vue";
import ScriptWhatsApp from "../components/widgets/ScriptWhatsApp.vue";
// import ScriptTawkto from "../components/ScriptTawkto.vue";

interface Props {
    title: string;
    description: string;
    image?: string;
    authorName?: string;
    pubDate?: string | Date;
    robotsTag?: string;
    tags?: string[];
    categories?: string[];
}
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/blog-placeholder-1.webp', authorName = 'Autor desconocido', pubDate = 'Fecha no disponible',robotsTag = 'index, follow', tags = [], categories = [] } = Astro.props;
const keywords = [...tags, ...categories].join(", ");
const pubDateString = pubDate instanceof Date ? pubDate.toISOString() : pubDate || 'Fecha no disponible';

// Generar el JSON-LD como una cadena de texto
const jsonLd = `
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "${title}",
    "description": "${description}",
    "author": {
        "@type": "Person",
        "name": "${authorName}"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Nombre del sitio",
        "logo": {
            "@type": "ImageObject",
            "url": "/favicon.svg"
        }
    },
    "datePublished": "${pubDateString}",
    "dateModified": "${pubDateString}",
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "${canonicalURL.href}"
    },
    "image": "${image}"
}
`;
---

<!doctype html>
<head>
    <!-- Incluir JSON-LD   -->
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <meta name="keywords" content={keywords}/>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>

    <!-- URL canónica -->
    <link rel="canonical" href={canonicalURL.href}/>

    <!-- Metaetiquetas principales -->
    <title>{title}</title>
    <meta name="title" content={title}/>
    <meta name="description" content={description}/>

    <!-- Control de robots -->
    <meta name="robots" content={robotsTag} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article"/>
    <meta property="og:url" content={canonicalURL.href}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={image}/>

    <meta property="article:author" content={authorName}/>
    <meta property="article:published_time" content={pubDateString}/>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content={canonicalURL.href}/>
    <meta property="twitter:title" content={title}/>
    <meta property="twitter:description" content={description}/>
    <meta property="twitter:image" content={image}/>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&display=swap" rel="stylesheet">
</head>

<body>
<Header/>
<NavBar/>
<div class="min-h-screen">
    <slot/>
</div>
<Footer/>
<ScriptAnimation client:only="vue"/>
<ScriptWhatsApp client:only="vue"/>
<!-- <ScriptTawkto client:only="vue"/> -->

</body>
