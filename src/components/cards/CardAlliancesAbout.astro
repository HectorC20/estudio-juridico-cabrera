---
import type { Partner } from "@/models/Partner";

export interface Props {
    partner: Partner;
}
const { partner } = Astro.props;
---

{partner.url ? (
<a href={partner.url} target="_blank" rel="noopener noreferrer" class="block hover:opacity-90 transition">
    <div class="section__card">
        <img class="section__card__img" src={partner.src} alt={partner.alt}/>
        <div class="section__card__content">
            <h3 class="section__card__title">{partner.name}</h3>
            <p class="section__card__desc hidden">{partner.pubDate ? partner.pubDate.toLocaleDateString() : ''}</p>
        </div>
    </div>
</a>
    ) : (
<div class="section__card">
    <img class="section__card__img" src={partner.src} alt={partner.alt}/>
    <div class="section__card__content">
        <h3 class="section__card__title">{partner.name}</h3>
        <p class="section__card__desc hidden">{partner.pubDate ? partner.pubDate.toLocaleDateString() : ''}</p>
    </div>
</div>
    )}
