---
import '@/styles/components/home/sectionNoticesHome.css';
---
<section class="my-12 section-notices-home">
  <div class="part__noticias__home">
      <h3 class="title__notices__home">Casos de Éxito</h3>
      <a href="/casos" class="btn__notices__home"><button>Ver más</button></a>
  </div>

  <ul>
      <!-- Caso 1 -->
      <li class="rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105">
        <a href="/casos/conflicto-societario" class="block">
            <img src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Caso Corporativo" class="w-full h-48 object-cover"/>
            <div class="text-overlay">
                <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">Resolución de Conflicto Societario</h4>
                <p class="date 2xl:text-xl text-secondaryLocal">
                   Corporativo
                </p>
                <div class="more__des">Leer Más</div>
                <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
            </div>
        </a>
      </li>

      <!-- Caso 2 -->
      <li class="rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105">
        <a href="/casos/recuperacion-propiedad" class="block">
            <img src="https://images.unsplash.com/photo-1505664194779-8beaceb93744?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Caso Civil" class="w-full h-full object-cover"/>
            <div class="text-overlay">
                <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">Recuperación de Propiedad</h4>
                <p class="date 2xl:text-xl text-secondaryLocal">
                   Civil
                </p>
                <div class="more__des">Leer Más</div>
                <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
            </div>
        </a>
      </li>

      <!-- Caso 3 -->
      <li class="rounded-lg overflow-hidden transition-transform duration-300 hover:scale-105">
        <a href="/casos/defensa-laboral" class="block">
            <img src="https://images.unsplash.com/photo-1521791055366-0d553872125f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Caso Laboral" class="w-full h-full object-cover"/>
            <div class="text-overlay">
                <h4 class="title text-lg 2xl:text-xl font-semibold text-secondaryLocal">Defensa Laboral Colectiva</h4>
                <p class="date 2xl:text-xl text-secondaryLocal">
                   Laboral
                </p>
                <div class="more__des">Leer Más</div>
                <div class="h-1 w-full bg-tertiaryLocal absolute bottom-0 left-0 rounded-b-md"></div>
            </div>
        </a>
      </li>
  </ul>
</section>
