---
// import '@/styles/partials/footer.css'
---
<style>
    .footer-ul-link{
        @apply grid w-full grid-cols-5 gap-4;
    }
    .footer-ul-link ul{
        @apply flex flex-col;
    }

    .border-footer {
        margin-left: auto;
        margin-right: auto;
        width: 30%;
        padding: 2px 0 2px;
        border-bottom: 1px #b7b7fa inset;
    }

    .footer-container {
        @apply text-xl lg:text-lg text-center ;
    }

    .footer-content {
        @apply text-fifthLocal pb-10 lg:pb-2;
    }

    .border-box-footer {
        padding: 18px 0 18px;
        font-size: 16px;
        line-height: 24px;
        box-shadow: 0 -7px 12px -14px ;
        width: 80%;
        margin-left: auto;
        margin-right: auto;
        @apply shadow-secondaryLocal !important;
    }

    .footer-box {
        @apply flex-1 flex justify-center mb-2;
    }

    .footer-logo {
        @apply h-24  ;
    }

    .footer-border {
        @apply border-footer shadow-md;
    }


    .footer-links ul {
        @apply flex flex-row gap-8;
    }

    .footer-link {
        @apply hover:text-secondaryLocal;
    }

    .footer-bottom {
        @apply py-14 lg:py-4 px-14 gap-4  text-fifthLocal/60 flex flex-wrap text-center  lg:justify-end;

    }

    .footer-bottom li:last-child {
        @apply   hover:text-blue-600 text-lg  font-semibold font-['Assistant'] ;
    }
</style>
<footer class="footer-container ">
    <div class="footer-content">
        <div class="border-box-footer">
        </div>
    </div>
    <div class="footer-ul-link">
    </div>
    <ul class="footer-bottom">
        <li>2024 - 2025 Estudio Jurídico Cabrera copyright - Desarrollado por </li>
        <li><a href="https://portfolio-beta-lovat-16.vercel.app/" target="_blank">Héctor
        </a></li>
    </ul>
    <div class="fonts">
        <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@200..800&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inspiration&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Asap+Condensed:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap" rel="stylesheet">
    </div>
</footer>
