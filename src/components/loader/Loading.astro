---
export let isLoading = true;
---

<div id="loading-screen" class={`loading-screen ${isLoading ? '' : 'hidden'}`}>
    <div class="content-wrapper">
        <div class="image-container relative">
            <!-- Imagen para teléfonos -->
            <img
                    class="content__image sm:hidden"
                    src="https://res.cloudinary.com/dixzojb4s/image/upload/v1743350834/fondo_para_telefonos_b77hfx_tzlzit.webp"
                    alt="Logo 30 años para teléfonos"
            />
            <!-- Imagen para pantallas grandes -->
            <img
                    class="content__image hidden sm:block"
                    src="https://res.cloudinary.com/dixzojb4s/image/upload/v1743351034/FONDO_DE_PANTALLA_urhcoa_muidyj.webp"
                    alt="Logo 30 años para laptops y tablets"
            />
            <!-- Capa de animación del borde -->
            <div class="absolute inset-0 rounded-xl border-4 border-transparent animate-border-loading"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const loader = document.getElementById('loading-screen');
        const mainContent = document.getElementById('main-content');
        const hasVisited = sessionStorage.getItem('hasVisited');

        // Función para mostrar el contenido principal
        const showContent = () => {
            if (loader) {
                loader.classList.add('hidden');
                setTimeout(() => loader.style.display = 'none', 500);
            }
            if (mainContent) {
                mainContent.classList.remove('hidden');
                // Disparar evento para inicializaciones dependientes (ej. animaciones)
                window.dispatchEvent(new Event('main-content-visible'));
            }
        };

        if (hasVisited) {
            // Si ya visitó, mostrar contenido inmediatamente sin loader
            if (loader) loader.style.display = 'none';
            if (mainContent) mainContent.classList.remove('hidden');
        } else {
            // Si es primera vez, marcar como visitado y ejecutar animación
            sessionStorage.setItem('hasVisited', 'true');
            
            // Esperar a que toda la página cargue (imágenes, recursos)
            window.addEventListener('load', () => {
                const minDisplayTime = 3000; // 3 segundos mínimo
                
                setTimeout(() => {
                    showContent();
                }, minDisplayTime);
            });
        }
    });
</script>

<style>
    @keyframes border-loading {
        0% {
            border-color: transparent;
        }
        50% {
            border-color: rgba(59, 130, 246, 1); /* Azul (Tailwind blue-500) */
        }
        100% {
            border-color: transparent;
        }
    }

    .loading-screen {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        z-index: 1000;
        transition: opacity 0.5s ease;
    }
    .loading-screen.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        z-index: 10;
    }

    .image-container {
        width: 100%;
        height: 100%;
        display: flex;
        position: relative;
    }

    .content__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .animate-border-loading {
        animation: border-loading 2s infinite ease-in-out;
    }
</style>
